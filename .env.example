# Copy to .env for local development. Never commit the filled-in file.
# On Vercel, set the same names in Project Settings → Environment Variables.

# Postgres for payment and subscription records. Neon and other hosted
# Postgres URLs work. This is required before a real prompt can be sent.
DATABASE_URL=

# Public site origin, no trailing slash. Used to build the M-Pesa callback
# when MPESA_CALLBACK_URL is empty. Example: https://tapnet-network-udrn.vercel.app
APP_URL=

# Optional. When set, listing every payment requires
# Authorization: Bearer <this token>. Leave empty only on a private demo.
PAYMENTS_ADMIN_TOKEN=

# --- Safaricom Daraja: M-Pesa STK Push (Lipa na M-Pesa Online) ---
# sandbox uses https://sandbox.safaricom.co.ke
# live uses https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Public HTTPS URL Safaricom can reach. Defaults to $APP_URL/api/payments/mpesa-callback
MPESA_CALLBACK_URL=
# PayBill default. Use CustomerBuyGoodsOnline for a till number.
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- IntaSend: Airtel Money Kenya collection push ---
# sandbox uses https://sandbox.intasend.com
# live uses https://api.intasend.com
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_ENV=sandbox
# Same secret you type when creating the IntaSend webhook. Required before
# a webhook is allowed to confirm a payment.
INTASEND_WEBHOOK_CHALLENGE=
